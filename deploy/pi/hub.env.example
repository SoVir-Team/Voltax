# /etc/voltax/hub.env (root:root 0600). provision.sh writes the real file.
# Placeholders only: never commit real values.
HUB_ID=voltax-hub-001
HUB_NAME=My Home
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=hub
MQTT_PASSWORD=__GENERATED_BY_PROVISION__
PORT=8443
TZ=Asia/Kolkata
LOG_LEVEL=info
TLS_CERT=/etc/voltax/tls/hub.crt
TLS_KEY=/etc/voltax/tls/hub.key
TLS_CA=/etc/voltax/tls/ca.crt
