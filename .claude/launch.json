{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "voltax-dev-hub",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 8080
    },
    {
      "name": "voltax-dev-hub-demo",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "backend/hub/dev/dev-hub.mjs",
        "--demo"
      ],
      "port": 8080
    },
    {
      "name": "voltax-dev-cloud-demo",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "backend/cloud/dev/dev-cloud.mjs",
        "--demo"
      ],
      "port": 8090
    },
    {
      "name": "voltax-dev-hub-accounts",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "backend/hub/dev/dev-hub.mjs",
        "--demo",
        "--mailpit"
      ],
      "port": 8080
    }
  ]
}
