{
  "name": "voltax",
  "private": true,
  "workspaces": [
    "shared/contracts",
    "backend/hub",
    "backend/cloud",
    "frontend/web",
    "frontend/admin"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "dev": "npm run build -w frontend/web && npm run dev -w backend/hub",
    "dev:web": "npm run dev -w frontend/web",
    "typecheck": "npm run build -w shared/contracts && npm run typecheck --workspaces",
    "test": "npm run build -w shared/contracts && npm run test --workspaces --if-present",
    "test:host": "node tools/test-host.mjs",
    "test:pg": "npm run test:pg -w backend/cloud",
    "test:brokers": "npm run test:brokers -w backend/cloud",
    "test:services": "npm run test:services -w backend/cloud",
    "dev:admin": "npm run dev -w frontend/admin",
    "lint": "eslint .",
    "audit:prod": "npm audit --omit=dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.3",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.72.1"
  }
}
